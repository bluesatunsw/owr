	(text "Vo=0.8V*(1+47k/15k)=3.31V\nfsw=92417/(220k)^0.991=441kHz\nL=3.3V*(24V-3.3V)/(24V*20%*2A*441kHz)=16.1uH (15uH used)\nfp=2A/(2*pi*3.3V*35uF)=2.76kHz\nRc=(2*pi*25kHz*35uF/17A/V)*(3.3V/(0.8V*350uA/V))=3.8k (3k3 used)\nCc=1/(2*pi*3k3*2.76kHz)=17.5nF (33n used)\nCp=1/(pi*3k3*441kHz)=219pF (330p used, optional)"
		(exclude_from_sim no)
		(at 105.664 75.946 0)
		(effects
